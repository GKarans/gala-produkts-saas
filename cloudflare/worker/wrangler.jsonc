{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lumiq-cam",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "lumiq.cam",
      "custom_domain": true
    }
  ],
  "vars": {
    "PLATFORM_MODE": "staging",
    "PLATFORM_RELEASE_APPROVED": "staging",
    "PLATFORM_ORIGIN": "https://lumiq.cam",
    "PLATFORM_SUPABASE_PROJECT_REF": "mkycfegxlzidaezljutq"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "../../platform/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/healthz", "/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "96846aaf46fd470e96f0313b09e1d01a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_PHOTOS",
      "bucket_name": "lumiq-staging-photos"
    }
  ],
  "observability": {
    "enabled": true
  }
}
